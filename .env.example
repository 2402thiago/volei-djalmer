# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" NÃO deve ser versionado (está no .gitignore).

# Caminho do arquivo JSON da conta de serviço do Google Cloud
# Ex.: GOOGLE_SERVICE_ACCOUNT_JSON=./credenciais/voluntariado-sheets.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID (URL) da planilha do Google Sheets
# Ex.: GOOGLE_SHEETS_ID=1AbCdEfGhIjKlMnO pQRsTuV
GOOGLE_SHEETS_ID=

# Frequência do polling de sincronização em segundos
SYNC_INTERVAL_SECONDS=20

# Modo de execução: "production" usa a planilha real;
# "test" não exige credenciais (usa repositório em memória)
APP_ENV=production