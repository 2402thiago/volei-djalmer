# O sistema usa localStorage no navegador e memória no backend.
APP_ENV=local

# Google Sheets (conta de serviço central)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_INFO={"type":"service_account",...}

# Google Drive privado para comprovantes (pasta compartilhada com a conta de serviço).
GOOGLE_DRIVE_FOLDER_ID=

# Identidade Google OAuth (authorization-code flow). Use HTTPS em produção.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_OAUTH_SESSION_SECRET=
